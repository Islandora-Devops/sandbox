{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>islandora-devops/.github:renovate.json5',
  ],
  customDatasources: {
    'fedora-coreos': {
      defaultRegistryUrlTemplate: 'https://builds.coreos.fedoraproject.org/streams/{{packageName}}.json',
      transformTemplates: [
        '{ "releases": [{ "version": architectures.x86_64.artifacts.digitalocean.release }] }',
      ],
    },
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Update isle-buildkit tag',
      managerFilePatterns: [
        '/^\\.env$/',
      ],
      matchStrings: [
        'ISLANDORA_TAG=(?<currentValue>[\\d\\.]+)',
      ],
      datasourceTemplate: 'github-releases',
      packageNameTemplate: 'Islandora-Devops/isle-buildkit',
      versioningTemplate: 'semver',
    },
    {
      customType: 'regex',
      description: 'Update sandbox Docker CLI plugin versions',
      managerFilePatterns: [
        '/^rootfs\\/opt\\/sandbox\\/setup\\.sh$/',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s+packageName=(?<packageName>\\S+)\\s*\\n[A-Z0-9_]+_VERSION=(?<currentValue>\\S+)',
      ],
    },
    {
      customType: 'regex',
      description: 'Update Fedora CoreOS stream version',
      managerFilePatterns: [
        '/\\.tf$/',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+packageName=(?<packageName>\\S+)\\s+versioning=(?<versioning>\\S+)\\s+coreos_version\\s*=\\s*"(?<currentValue>[^"]+)"',
      ],
    },
  ],
}
